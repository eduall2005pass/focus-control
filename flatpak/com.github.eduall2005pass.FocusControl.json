{
  "app-id": "com.github.eduall2005pass.FocusControl",
  "runtime": "org.gnome.Platform",
  "runtime-version": "47",
  "sdk": "org.gnome.Sdk",
  "command": "focus-control",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.Flatpak",
    "--talk-name=org.gnome.SessionManager",
    "--filesystem=home"
  ],
  "modules": [
    {
      "name": "focus-control",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 focus-reminder-ubuntu.py /app/bin/focus-control",
        "install -Dm644 assets/focus-reminder.png /app/share/icons/hicolor/48x48/apps/com.github.eduall2005pass.FocusControl.png",
        "install -Dm644 flatpak/com.github.eduall2005pass.FocusControl.desktop /app/share/applications/com.github.eduall2005pass.FocusControl.desktop",
        "install -Dm644 flatpak/com.github.eduall2005pass.FocusControl.metainfo.xml /app/share/metainfo/com.github.eduall2005pass.FocusControl.metainfo.xml"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}
