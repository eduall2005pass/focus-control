#!/bin/sh
# Allow upgrades and normal package removal.  End an active lockout explicitly
# only through the uninstall administrator workflow, never from package scripts.
if [ "$1" = "upgrade" ]; then
    exit 0
fi
systemctl disable --now focus-lockout.service >/dev/null 2>&1 || true
systemctl disable --now focus-app-enforcer.service >/dev/null 2>&1 || true
systemctl disable --now focus-boot-enforce.service >/dev/null 2>&1 || true
exit 0
